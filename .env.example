# AI-OpenPlatform 部署环境变量（复制为 .env 后按需修改）
# docker compose -f docker-compose.deploy.yml 启动时自动读取同目录 .env

# DeepSeek 模型调用密钥；为空时 /v1 调用会预占后释放并记失败审计
DEEPSEEK_API_KEY=

# 管理后台密码（用户名固定 admin，见 application.yaml）
ADMIN_PASSWORD=123456

# MySQL root 密码（需与 docker/mysql/init/01-init.sql 一致；首次初始化后改密码还需手动 ALTER USER）
MYSQL_PASSWORD=20030226
